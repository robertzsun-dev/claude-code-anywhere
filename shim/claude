#!/usr/bin/env bash

# Claude Code Interceptor Shim
# This script transparently wraps the real claude command and connects to the session server

# Configuration
CLAUDE_REMOTE_DIR="${CLAUDE_REMOTE_DIR:-$HOME/claude-code-anywhere}"
CLAUDE_ORIGINAL="${CLAUDE_ORIGINAL:-/opt/node22/bin/claude-original}"
AUTO_CONNECT="${CLAUDE_AUTO_CONNECT:-true}"

# Detect if server is running and whether it's using HTTPS
server_running=false
detected_protocol="ws"
if [ "$AUTO_CONNECT" = "true" ]; then
    # Try HTTPS first (wss://)
    if timeout 0.5 bash -c 'curl -k -s https://localhost:8085/health > /dev/null 2>&1'; then
        server_running=true
        detected_protocol="wss"
    # Fall back to HTTP (ws://)
    elif timeout 0.5 bash -c 'curl -s http://localhost:8085/health > /dev/null 2>&1'; then
        server_running=true
        detected_protocol="ws"
    fi
fi

# Use detected protocol or environment variable
SERVER_URL="${CLAUDE_REMOTE_SERVER:-${detected_protocol}://localhost:8085}"

# If server is running and we have the intercept module, use it
if [ "$server_running" = "true" ] && [ -f "$CLAUDE_REMOTE_DIR/src/intercept/intercept.cjs" ]; then
    # Run claude directly with the API interceptor loaded via --require.
    # This injects into the same process (no PTY, no wrapper) and enables:
    #   - Structured API event capture (requests, SSE, responses)
    #   - Remote stdin injection from the web viewer
    export CLAUDE_INTERCEPT_SERVER="$SERVER_URL"
    export NODE_OPTIONS="--require $CLAUDE_REMOTE_DIR/src/intercept/intercept.cjs${NODE_OPTIONS:+ $NODE_OPTIONS}"
    exec "$CLAUDE_ORIGINAL" "$@"
else
    # Server not running or auto-connect disabled, run original claude directly
    exec "$CLAUDE_ORIGINAL" "$@"
fi
