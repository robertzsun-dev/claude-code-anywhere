{
  "name": "claude-code-remote-access",
  "version": "1.0.0",
  "description": "Remote access system for Claude Code sessions",
  "type": "module",
  "scripts": {
    "server": "node src/server.js",
    "intercept": "CLAUDE_INTERCEPT_SERVER=ws://localhost:8085 node --require ./src/intercept/intercept.cjs -e 'console.log(\"Interceptor test: module loaded successfully\")'",
    "test": "node --test tests/**/*.test.js",
    "test:watch": "node --test --watch tests/**/*.test.js",
    "test:server": "node --test tests/server.test.js",
    "test:integration": "node --test tests/integration.test.js"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "firebase-admin": "^12.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
